# URL of the Express API. The Next.js server forwards /api/* to it, so the
# browser only ever talks to this origin (first-party session cookie).
API_URL=http://localhost:4000

# Optional: show a "Use demo admin" button on the sign-in page that fills these in.
# Must match SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD in backend/.env. Leave unset in production.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
